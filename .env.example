# ─────────────────────────────────────────────────────────────────────────────
# Pala Pitta Ruchulu — environment template
#
# Copy to `.env.local` for development and fill in real values. `.env.local`
# is git-ignored and must stay that way: it holds keys that bypass RLS, move
# money and send messages as the business. In production these are set in the
# hosting platform's environment settings, never in a file in the repo.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle and are public by
# definition. Everything without that prefix is server-only — if one of them
# ever appears in client code, treat it as leaked and rotate it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Feeds the sitemap, robots.txt, the
# WhatsApp order-tracking links and the same-origin check on public API routes.
NEXT_PUBLIC_SITE_URL=https://palapittaruchulu.vercel.app

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses every RLS policy. Full read/write on the database.
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase (SMS OTP only) ──────────────────────────────────────────────────
# Public by design: these identify the project, they don't authorize anything.
# Phone sign-in degrades to email if they're absent.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google OAuth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# SERVER ONLY
GOOGLE_CLIENT_SECRET=

# ── Razorpay ─────────────────────────────────────────────────────────────────
# The NEXT_PUBLIC copy opens the checkout modal in the browser. Server routes
# read RAZORPAY_KEY_ID; set both to the same key id.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
# SERVER ONLY — signs and verifies payments, and can issue refunds.
RAZORPAY_KEY_SECRET=

# ── Web push (VAPID) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SERVER ONLY — signs push payloads to staff devices.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:palapittaruchulu@gmail.com

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
# SERVER ONLY — sends messages as the business.
WHATSAPP_ACCESS_TOKEN=

# ── Aggregator webhooks ──────────────────────────────────────────────────────
# Until these are set, /api/webhooks/{swiggy,zomato} refuse every request with
# a 503 rather than accepting orders from anyone who finds the URL.
SWIGGY_WEBHOOK_SECRET=
ZOMATO_WEBHOOK_SECRET=

# ── Compliance ───────────────────────────────────────────────────────────────
# Printed on customer bills when set, hidden entirely when blank. An FSSAI
# licence number is legally required on food bills in India — fill this in
# before serving customers.
NEXT_PUBLIC_FSSAI=
NEXT_PUBLIC_GSTIN=

# ── Security ─────────────────────────────────────────────────────────────────
# The Content-Security-Policy ships report-only by default so a slightly-too-
# tight rule can't take the Razorpay modal down. Set to `true` to enforce it
# once the violation reports from real traffic are clean.
CSP_ENFORCE=false
